{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": { "@/*": ["../../frontend/src/*"] }
  },
  "include": [
    "design/**/*.ts",
    "design/**/*.vue",
    "shared/**/*.ts",
    "shared/**/*.vue",
    "element/**/*.ts",
    "element/**/*.vue",
    "naive/**/*.ts",
    "naive/**/*.vue",
    "nuxt/**/*.ts",
    "nuxt/**/*.vue"
  ]
}
