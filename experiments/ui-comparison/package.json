{
  "name": "investment-ui-comparison",
  "private": true,
  "type": "module",
  "scripts": {
    "build:element": "UI_VARIANT=element vite build",
    "build:naive": "UI_VARIANT=naive vite build",
    "build:nuxt": "UI_VARIANT=nuxt vite build",
    "build:design": "UI_VARIANT=design vite build",
    "build": "npm run build:element && npm run build:naive && npm run build:nuxt",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "serve": "node serve.mjs",
    "check": "node check.mjs",
    "measure": "node measure.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "vue": "3.5.27",
    "vue-router": "4.6.4",
    "element-plus": "2.13.2",
    "naive-ui": "2.45.3",
    "@nuxt/ui": "4.11.3",
    "reka-ui": "2.10.5",
    "tailwindcss": "4.3.3",
    "@internationalized/date": "3.12.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "vite": "5.4.21",
    "typescript": "5.6.3",
    "vue-tsc": "2.2.12",
    "@types/node": "20.19.43"
  }
}
