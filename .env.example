# Environment Variables for Production Deployment
# Copy this file to .env and fill in your values

# PostgreSQL - keep the real password only in .env
DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:5432/<db-name>

# Public origins allowed to call the backend API
CORS_ORIGINS=https://<app-host>,https://<app-host>:443

# Security - Generate with: openssl rand -hex 32
SECRET_KEY=<openssl-rand-hex-32>

# User Passwords - Use strong passwords (min 12 chars, mixed case, numbers, special chars)
ADMIN_INITIAL_PASSWORD=<strong-admin-initial-password>
DEMO_INITIAL_PASSWORD=<strong-user-initial-password>

# Market data - optional; leave empty to disable direct Tushare refresh
TUSHARE_TOKEN=
# Tushare 全局最小调用间隔秒数（默认 0.35 ≈ 170 次/分；配额富余可调小）
TUSHARE_GLOBAL_MIN_INTERVAL_SECONDS=0.35
# 接口级频率错误的自适应冷却（只有真撞限才生效，正常路径零开销）
TUSHARE_COOLDOWN_BASE_SECONDS=65
TUSHARE_COOLDOWN_MAX_SECONDS=900
# 年报清单缓存 TTL（小时）：清单一年只变一次，缓存可把批量分析的 cninfo 外呼降为零
REPORT_TARGET_PLAN_TTL_HOURS=24

# 批量标的分析（持仓页一键分析）
SECURITY_ANALYSIS_FRESHNESS_HOURS=24
SECURITY_ANALYSIS_BATCH_PAUSE_SECONDS=5
SECURITY_ANALYSIS_BATCH_MAX_SECONDS=14400

# SEC EDGAR（美股标的档案）：官方合规要求 UA 带联系方式，如 "investment-tracker/1.0 (you@example.com)"
EDGAR_USER_AGENT=

# 分红公告同步（Tushare dividend；仅 A/B 股，手动触发为主）
DIVIDEND_SYNC_LOOKBACK_DAYS=365
DIVIDEND_SYNC_MATCH_WINDOW_DAYS=30
# 周期自动同步（每周）默认关闭；开启前确认 Tushare 积分配额充足
DIVIDEND_SYNC_PERIODIC_ENABLED=false

# Frontend TLS/nginx settings used by docker-compose.yml
NGINX_SERVER_NAME=<app-host>
SSL_CERT_FULLCHAIN=./certs/lan/fullchain.pem
SSL_CERT_PRIVKEY=./certs/lan/privkey.pem
FRONTEND_HTTP_PORT=80
FRONTEND_HTTPS_PORT=443
BACKEND_LOG_DIR=./backend/logs
NGINX_LOG_DIR=./logs/nginx
APP_BASE_URL=https://<app-host>

# Create the LAN certificate with:
# openssl req -x509 -newkey rsa:2048 -nodes \
#   -keyout certs/lan/privkey.pem \
#   -out certs/lan/fullchain.pem \
#   -days 825 \
#   -subj /CN=<app-host> \
#   -addext subjectAltName=DNS:<app-host>,DNS:localhost,IP:127.0.0.1

# API Documentation - Set to false in production
ENABLE_DOCS=false
REQUIRE_HTTPS=true
PRICE_REFRESH_MAX_WORKERS=4
# 股价主动刷新的新鲜度窗口秒数（窗口内重复点击跳过）
PRICE_REFRESH_FRESHNESS_SECONDS=600
# 会话令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=30
# 后台任务 worker（价格刷新/历史同步/定期复盘的可靠性网；关闭则只剩 API 内联快路径）
BACKGROUND_WORKER_ENABLED=true
BACKGROUND_JOB_RETENTION_HOURS=168
BACKGROUND_JOB_STALE_MINUTES=60
BACKGROUND_JOB_POLL_SECONDS=5
BACKGROUND_JOB_LEASE_SECONDS=300
BACKGROUND_JOB_MAX_ATTEMPTS=3
BACKGROUND_JOB_RETRY_BASE_SECONDS=30
APP_VERSION=1.0.0
BUILD_SHA=unknown

# Note: .env file is in .gitignore and will not be committed to git

# LLM 复盘报告（DeepSeek，OpenAI 兼容接口；留空则禁用该功能）
# 注意：定期自动生成依赖 BACKGROUND_WORKER_ENABLED=true（默认开启）
# 默认留空 = 功能禁用（接口返回 409、定期调度静默跳过）；填入真实 key 后启用
LLM_REPORT_API_KEY=
LLM_REPORT_BASE_URL=https://api.deepseek.com
LLM_REPORT_MODEL=deepseek-v4-pro
LLM_REPORT_TIMEOUT_SECONDS=120
LLM_REPORT_MAX_OUTPUT_TOKENS=8192
