# ============================================================================
# 投资追踪系统 - Docker Compose 部署环境变量模板
#
#   cp .env.example .env    # 然后按下面的分组填写；.env 已 gitignore，不要提交
#
# 读取方式（重要）：
# - `.env` 只由 docker compose 读取，用来插值 docker-compose.yml；后端容器**只看得到**
#   docker-compose.yml 里 backend `environment:` 下传的变量（镜像不带 .env）。
# - 新增配置必须三处同步：backend/app/config.py ⇄ docker-compose.yml ⇄ 本文件，
#   backend/tests/test_deploy_config_sync.py 会在 CI 上守着。
# - 带默认值的旋钮一律**注释掉**：未设置时由 config.py（或 compose 的 `:-` 默认）生效；
#   取消注释才覆盖。不要照抄默认值——那会把今天的默认值钉死在 .env 里，日后代码
#   调整默认值时部署拿不到（#128 的 LLM 输出额度就是这么失效的）。
# - 各变量的完整说明见 DEPLOYMENT.md「环境变量」一节。
# ============================================================================


# ---------------------------------------------------------------------------
# 1. 必填（docker-compose.yml 用 `${VAR:?}` 强制，缺一个 compose 直接报错）
# ---------------------------------------------------------------------------
# 外部 PostgreSQL 16（真实口令只放 .env）
DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:5432/<db-name>
# 允许调用后端 API 的前端 origin（逗号分隔；非 443 端口要带端口号）
CORS_ORIGINS=https://<app-host>,https://<app-host>:443
# JWT 签名密钥：openssl rand -hex 32
SECRET_KEY=<openssl-rand-hex-32>
# manage.py seed 创建初始用户时使用的口令（至少 12 位，大小写+数字+符号）
ADMIN_INITIAL_PASSWORD=<strong-admin-initial-password>
DEMO_INITIAL_PASSWORD=<strong-user-initial-password>
# Nginx：对外主机名与 TLS 证书（宿主路径，只读挂载进前端容器）
NGINX_SERVER_NAME=<app-host>
SSL_CERT_FULLCHAIN=./certs/lan/fullchain.pem
SSL_CERT_PRIVKEY=./certs/lan/privkey.pem

# 生成 LAN 自签证书：
# openssl req -x509 -newkey rsa:2048 -nodes \
#   -keyout certs/lan/privkey.pem \
#   -out certs/lan/fullchain.pem \
#   -days 825 \
#   -subj /CN=<app-host> \
#   -addext subjectAltName=DNS:<app-host>,DNS:localhost,IP:127.0.0.1


# ---------------------------------------------------------------------------
# 2. 端口与日志目录（只给 compose 用）
# ---------------------------------------------------------------------------
FRONTEND_HTTP_PORT=80
# 同时决定 HTTP→HTTPS 重定向与 497 兜底重定向的目标端口（compose 以 NGINX_HTTPS_PORT
# 传给 nginx 模板，不要另设 NGINX_HTTPS_PORT）
FRONTEND_HTTPS_PORT=443
# 宿主日志目录：后端容器以 uid 10001 运行，目录须可被它写入（见 DEPLOYMENT.md）
BACKEND_LOG_DIR=./backend/logs
NGINX_LOG_DIR=./logs/nginx


# ---------------------------------------------------------------------------
# 3. 安全与会话
# ---------------------------------------------------------------------------
# 代码默认值就是这里的值（fail-closed），写出来只为显式可见；开发环境反过来放宽。
ENABLE_DOCS=false
REQUIRE_HTTPS=true
# 是否采信反代请求头（X-Forwarded-Proto 判 HTTPS、X-Forwarded-For 取审计 IP）。
# 只在后端端口不直接对外、且反代会覆写这些头时置 true——本仓 compose 拓扑满足。
# 前提是 uvicorn 带 --no-proxy-headers 启动（Dockerfile 已如此）。
TRUST_PROXY_HEADERS=true
# 访问令牌有效期（分钟）
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# 会话自首次登录起的绝对上限（小时）：到顶即吊销，被窃 cookie 无法靠续期永久续命
# SESSION_ABSOLUTE_MAX_HOURS=168


# ---------------------------------------------------------------------------
# 4. 版本标识与业务时区
# ---------------------------------------------------------------------------
# /health 的 build 字段。升级时改成 `git rev-parse --short HEAD`（见 DEPLOYMENT.md「升级」）
BUILD_SHA=unknown
# APP_VERSION=1.0.0
# 业务时区：UTC 时间戳落成「哪一天」、以及「今天」是哪天都按它算。
# 容器系统时区是 UTC，不能依赖——必须由应用层显式配置
# DISPLAY_TIMEZONE=Asia/Shanghai


# ---------------------------------------------------------------------------
# 5. 数据源
# ---------------------------------------------------------------------------
# Tushare token（可选）：行情刷新、A股档案、分红同步、标的全集都依赖它；留空则这些功能不可用
TUSHARE_TOKEN=

# --- Tushare 限速（全局闸 + 接口级自适应冷却，正常路径零开销）---
# 全局最小调用间隔秒数（0.35 ≈ 170 次/分；配额富余可调小，0 = 关闭全局闸）
# TUSHARE_GLOBAL_MIN_INTERVAL_SECONDS=0.35
# TUSHARE_COOLDOWN_BASE_SECONDS=65
# TUSHARE_COOLDOWN_MAX_SECONDS=900
# 港股行情接口（hk_daily/hk_mins）单接口最小间隔秒数
# TUSHARE_HK_MIN_INTERVAL_SECONDS=31
# Tushare HTTPS 数据接口地址（留空 = 默认地址）
# TUSHARE_API_BASE_URL=https://api.waditu.com/dataapi

# --- SEC EDGAR（美股档案与 10-K/20-F）---
# SEC 合规要求 UA 带联系方式，形如 `your-app your-email@example.com`。
# 留空会用占位 UA 并告警；SEC 对不合规 UA 可能直接 403。
EDGAR_USER_AGENT=

# --- Tiingo（api.tiingo.com 免费档：美股报价与日线）---
# 报价链 Tushare → Tiingo（IEX 实时价，陈旧则取最新日线收盘）→ 雪球；
# 日线链 Tushare → Tiingo EOD（含复权收盘）→ 腾讯 K 线。
# 在 tiingo.com 注册后于 Account → API → Token 取得；留空 = 关闭该数据源（显式降级，直接走下一源）。
# 免费档约 50 次/小时、1000 次/天、每月 500 个不同 ticker；撞 429 后进程内冷却 10 分钟不再外呼。
TIINGO_API_TOKEN=
# 进程级最小请求间隔（秒）与单次请求超时（秒）
# TIINGO_MIN_INTERVAL_SECONDS=1.0
# TIINGO_TIMEOUT_SECONDS=15.0

# --- 雪球（stock.xueqiu.com：美股行情兜底 + A股 xueqiu_* 档案数据集 + 观点摘要）---
# COOKIES / COOKIE_FILE 二选一，COOKIES 优先；两个都留空 = 关闭该数据源（显式降级）。
# 推荐 COOKIE_FILE 并存浏览器插件的完整导出：探活脚本要读 expirationDate 才能在
# xq_a_token（约 15 天寿命）过期前告警。
# Cookie 文件所在**宿主目录**挂载到容器 /app/secrets/（挂目录不挂文件——缺失的
# 文件路径会被 Docker 误建成目录）；XUEQIU_COOKIE_FILE 填容器内路径。backend 可写
# （观点页管理员「更新 Cookie」原子替换该文件并留 .bak，只对 COOKIE_FILE 生效），
# 采集器只读；宿主目录须一次性授权给容器 uid 10001，见 DEPLOYMENT.md 8.1。
XUEQIU_COOKIE_HOST_DIR=./backend/secrets
XUEQIU_COOKIE_FILE=
# 例：XUEQIU_COOKIE_FILE=/app/secrets/xueqiu.com.json
XUEQIU_COOKIES=
# 上游限速：按 [min, max] 秒随机间隔串行发请求。调低会更快撞 WAF，代价远大于省下的几秒
# XUEQIU_MIN_DELAY_SECONDS=2
# XUEQIU_MAX_DELAY_SECONDS=4
# XUEQIU_TIMEOUT_SECONDS=20
# Cookie 到期告警阈值（天），scripts/check_xueqiu_cookie_expiry.py 使用
# XUEQIU_COOKIE_WARN_DAYS=7
# XUEQIU_COOKIE_CRITICAL_DAYS=3
# 观点摘要：近期窗口（转向判断分界）/ LLM 输入回看深度 /
# 采集停摆预警阈值（小时；按最近一次状态为 ok/partial 的作者采集记录判断）
# XUEQIU_OPINION_RECENT_DAYS=30
# XUEQIU_OPINION_LOOKBACK_DAYS=180
# XUEQIU_OPINION_STALE_HOURS=48

# --- 雪球采集器（compose 服务 xueqiu-collector，与 backend 同一镜像、共用上面同一份 Cookie）---
# 默认关闭：关闭时进程只空转写心跳（healthcheck 仍健康），观点页显示「未启用」。
# 切换当天改成 true，再 `docker compose up -d backend xueqiu-collector`（见 DEPLOYMENT.md 第 8 节）
XUEQIU_COLLECTOR_ENABLED=false
# Uptime Kuma push URL（可选）：每轮作者采集结束推送，全部作者 ok/partial 才推 up
XUEQIU_COLLECTOR_PUSH_URL=
# 作者采集轮次间隔（分钟）
# XUEQIU_COLLECTOR_CYCLE_MINUTES=60
# 礼貌限速：相邻两次请求之间随机停顿 [min, max] 秒（勿调低）与单次超时
# XUEQIU_COLLECTOR_MIN_DELAY_SECONDS=10
# XUEQIU_COLLECTOR_MAX_DELAY_SECONDS=25
# XUEQIU_COLLECTOR_TIMEOUT_SECONDS=20
# 每轮最多几位作者（最久没跑的优先）、作者之间随机间隔（秒）
# XUEQIU_COLLECTOR_MAX_AUTHORS_PER_RUN=5
# XUEQIU_COLLECTOR_AUTHOR_GAP_MIN_SECONDS=180
# XUEQIU_COLLECTOR_AUTHOR_GAP_MAX_SECONDS=600
# 回看天数 / 主页页数上限（0 = 翻到窗口外为止）/ 每帖评论页数 / 旧帖判定天数与旧帖评论页数 / 重扫冷却（小时）
# XUEQIU_COLLECTOR_MONITOR_DAYS=30
# XUEQIU_COLLECTOR_PROFILE_PAGES=0
# XUEQIU_COLLECTOR_MAX_COMMENT_PAGES=6
# XUEQIU_COLLECTOR_STALE_POST_DAYS=30
# XUEQIU_COLLECTOR_STALE_COMMENT_PAGES=1
# XUEQIU_COLLECTOR_RESCAN_COOLDOWN_HOURS=12
# 阿里云 WAF 挑战页：命中几次中止本轮、冷却多久（秒）不开新一轮
# XUEQIU_COLLECTOR_MAX_WAF_HITS=1
# XUEQIU_COLLECTOR_WAF_COOLDOWN_SECONDS=1800
# 心跳文件（容器内相对 /app，默认落在挂载的日志目录）与 healthcheck 判活阈值（分钟）
# XUEQIU_COLLECTOR_HEARTBEAT_FILE=logs/xueqiu-collector.heartbeat
# XUEQIU_COLLECTOR_HEALTH_MAX_AGE_MINUTES=30
# 每日按标的采集（公告/讨论 + 组合调仓）：标的 = 全体用户持仓∪自选（A/B/港/美股，
# 扣除排除与现金管理规则）；业务时区每天 RUN_AFTER 之后一轮，每标的每类取最新 N 条
# （市场热帖已于 2026-09-28 下线，原热帖口径变量已删除）
# XUEQIU_COLLECTOR_SYMBOLS_ENABLED=true
# XUEQIU_COLLECTOR_SYMBOLS_RUN_AFTER=07:30
# XUEQIU_COLLECTOR_SYMBOL_COUNT=20
# 一轮有失败项（错误对象/未知结构/WAF/Cookie 不可用）时当天不记「已跑」，只把没成功的项留作待重试：
# 距上一轮 N 分钟后只重试失败项，当日最多几轮（含首轮），用尽后记当天已跑、剩余项明日随整轮再采
# XUEQIU_COLLECTOR_SYMBOLS_RETRY_MINUTES=60
# XUEQIU_COLLECTOR_SYMBOLS_MAX_ATTEMPTS=3


# ---------------------------------------------------------------------------
# 6. LLM（DeepSeek / OpenAI 兼容接口；API_KEY 留空 = AI 功能整体禁用，接口返回 409）
# ---------------------------------------------------------------------------
LLM_REPORT_API_KEY=
# LLM_REPORT_BASE_URL=https://api.deepseek.com
# LLM_REPORT_MODEL=deepseek-flash
# LLM_REPORT_TIMEOUT_SECONDS=120
# 输出额度（推理 token 与输出共享）：长分析报告被截断/为空时调大
# LLM_REPORT_MAX_OUTPUT_TOKENS=16384
# 港股报表科目映射单独的输出额度：finish_reason=length、内容为空时调大
# STATEMENT_MAX_OUTPUT_TOKENS=32768
# 标的分析（单只/批量）单独的输出额度：分析报 finish_reason=length（输出被截断）时调大
# SECURITY_ANALYSIS_MAX_OUTPUT_TOKENS=32768
# 年报清单缓存 TTL（小时）：清单一年只变一次，缓存把批量分析的 cninfo 外呼降为零
# REPORT_TARGET_PLAN_TTL_HOURS=24
# 批量标的分析：新鲜度窗口（小时，窗口内已分析的跳过）/ 标的间停顿秒数 / 墙钟上限秒数
# SECURITY_ANALYSIS_FRESHNESS_HOURS=24
# SECURITY_ANALYSIS_BATCH_PAUSE_SECONDS=5
# SECURITY_ANALYSIS_BATCH_MAX_SECONDS=14400


# ---------------------------------------------------------------------------
# 7. 后台任务与周期任务（都跑在 Web 进程内，见 DEPLOYMENT.md「运行时架构」）
# ---------------------------------------------------------------------------
# worker 是价格刷新/历史同步/AI 分析/定期复盘/周期任务的执行者；关闭则只剩 API 内联快路径
# BACKGROUND_WORKER_ENABLED=true
# 周期任务总开关：false 时 worker 只执行排队任务、不调度任何周期任务（E2E 隔离外呼用）。
# 生产勿关：告警检查本身也是周期任务，关掉后连「周期任务停了」都不会有告警
# PERIODIC_TASKS_ENABLED=true
# BACKGROUND_JOB_RETENTION_HOURS=168
# BACKGROUND_JOB_STALE_MINUTES=60
# 排队任务的放弃上限（小时）：排队不按心跳判失联，只防 worker 关闭时永远挂着
# BACKGROUND_JOB_QUEUED_TTL_HOURS=24
# BACKGROUND_JOB_POLL_SECONDS=5
# BACKGROUND_JOB_LEASE_SECONDS=300
# BACKGROUND_JOB_MAX_ATTEMPTS=3
# BACKGROUND_JOB_RETRY_BASE_SECONDS=30
# 价格刷新并发线程数 / 新鲜度窗口秒数（窗口内重复点击跳过）
# PRICE_REFRESH_MAX_WORKERS=4
# PRICE_REFRESH_FRESHNESS_SECONDS=600

# 港交所《每日行情报表》：港股收盘价官方 T+1 源（免 token/Cookie，6 小时一查）。
# 回看天数 / 每次最多下载份数（每份约 25MB）
# HKEX_DAYQUOT_SYNC_ENABLED=true
# HKEX_DAYQUOT_LOOKBACK_DAYS=10
# HKEX_DAYQUOT_MAX_REPORTS_PER_TICK=5
# 汇率：人民币汇率中间价（中国货币网，官方、免 token）为主源，frankfurter/open.er-api 只做比对；
# 最近一期中间价超过 N 天才降级写入第三方报价 / 比对差异告警阈值（%）
# FX_OFFICIAL_MAX_STALE_DAYS=10
# FX_CHECK_WARN_PCT=2.0
# 无风险利率：参考利率（SHIBOR 3M / 美国国库券 3M）周期同步开关；夏普/索提诺默认用的序列
# REFERENCE_RATE_SYNC_ENABLED=true
# RISK_FREE_SERIES=SHIBOR_3M
# 标的全集（录入表单下拉检索）：6 小时一查、按间隔判新鲜；手动 manage.py sync-security-catalog
# SECURITY_CATALOG_SYNC_ENABLED=true
# SECURITY_CATALOG_SYNC_INTERVAL_HOURS=168
# 行业分类（持仓页行业列/筛选）：官方为主（A股 Tushare / 美股 EDGAR SIC）+ 东方财富 F10 补缺，
# 每天一查、超过刷新天数才重拉；手动 manage.py sync-security-industries [--force]
# SECURITY_INDUSTRY_SYNC_ENABLED=true
# SECURITY_INDUSTRY_REFRESH_DAYS=30
# 分红公告同步（Tushare dividend；仅 A/B 股）。周期同步（每周）默认关闭，
# 开启前确认 Tushare 积分配额充足
# DIVIDEND_SYNC_LOOKBACK_DAYS=365
# DIVIDEND_SYNC_MATCH_WINDOW_DAYS=30
# DIVIDEND_SYNC_PERIODIC_ENABLED=false


# ---------------------------------------------------------------------------
# 8. 告警通知（Bark 推送到 iPhone/iPad；基于 Apprise，可叠加飞书/邮件等渠道）
# ---------------------------------------------------------------------------
# 配置 Bark：App Store 安装 Bark → 打开 App，复制首页示例里的 `https://api.day.app/<key>`
# （只要到 key 为止，后面的示例文字会被忽略）→ 填到 NOTIFY_URLS。多个渠道用空格或逗号分隔，
# 其他渠道直接写 Apprise URL（如自建 Bark `barks://<host>/<key>`、`mailtos://…`），不改代码。
# 配好后在后端容器里验证：docker compose exec backend python manage.py notify-test
# 留空 = 不推送（告警仍记录，管理员「系统告警」页可见）。详见 DEPLOYMENT.md「告警通知」
NOTIFY_URLS=
# 推送门槛（info / warning / critical）：低于它的告警只记录不推送
# NOTIFY_MIN_SEVERITY=warning
# 仍未恢复的告警每隔 N 小时再提醒一次
# NOTIFY_REMINDER_HOURS=24
# 采集器启用时，超过 N 小时没有一次成功的作者采集即告警
# NOTIFY_COLLECTOR_STALE_HOURS=3
# 告警检查周期任务（每 10 分钟：雪球采集器/Cookie/WAF、汇率源、周期任务、后台任务）总开关
# ALERT_CHECK_ENABLED=true
# 事件提醒总开关：新分红建议待确认、除净日临近、持仓单日价格异动（同样推到 NOTIFY_URLS）
# EVENT_NOTIFICATIONS_ENABLED=true
# 持仓单日涨跌幅（相对昨收，百分比）达到该值即推送，同一标的每个行情日只推一次
# NOTIFY_PRICE_MOVE_PCT=7
# 除净日在今天起 N 天内的持仓分红提前提醒
# NOTIFY_EX_DATE_DAYS_AHEAD=3
# 官方公告同步（巨潮/披露易/EDGAR）：每 30 分钟增量拉取跟踪标的公告并分类；首次回溯天数；重大公告推送
# ANNOUNCEMENT_SYNC_ENABLED=true
# ANNOUNCEMENT_BACKFILL_DAYS=365
# ANNOUNCEMENT_NOTIFY_ENABLED=true
# 数据自动刷新（详见 DEPLOYMENT.md「自动刷新一览」）：
# 交易时段每 15 分钟刷新持仓与自选实时价
# QUOTE_AUTO_REFRESH_ENABLED=true
# A股/B股/美股日线尾部每小时检查、落后才补（港股走港交所日报）
# PRICE_TAIL_SYNC_ENABLED=true
# A股估值快照（daily_basic）每个交易日 18:00 后刷新一次
# DAILY_BASIC_REFRESH_ENABLED=true
# 每周凌晨入队：档案同步 + 最新一期财报摘要/港股报表 + 观点摘要（后两项花 LLM）
# WEEKLY_DATA_REFRESH_ENABLED=true


# ---------------------------------------------------------------------------
# 9. 只给宿主脚本用的变量（compose 不读；backup.sh 也不读 .env——运行时在 shell 里设置）
# ---------------------------------------------------------------------------
# backup.sh（详见 DEPLOYMENT.md「备份与恢复」）：
# BACKUP_DIR=./backups
# BACKUP_MODE=postgres            # postgres | excel | full；不设则交互选择
# BACKUP_TABLES="t1 t2 alembic_version"   # 表级备份（investment_tables_<时间>.dump）；不设 = 整库
# BACKUP_PG_TOOL=                 # local | docker；不设则本机有 pg_dump 用本机，否则用容器
# BACKUP_PG_IMAGE=postgres:16     # 容器模式的客户端镜像，主版本须 ≥ 数据库主版本
# BACKUP_DOCKER_NETWORK=host      # 容器模式的网络；数据库在某个 compose 网络里时改成该网络名
# APP_BASE_URL=https://<app-host> # Excel 导出访问地址
# APP_CA_CERT=./certs/lan/fullchain.pem
# INVESTMENT_TRACKER_TOKEN=<bearer-token>
# BACKUP_NOTIFY=1                 # 备份失败时经 backend 容器推送告警 `backup`，成功时自动恢复
